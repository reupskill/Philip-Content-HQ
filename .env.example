# --- Required ---

# Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# Exactly the emails allowed to sign in, comma-separated (2 people)
ALLOWED_EMAILS=philipbabs29@gmail.com,ceocontent@uvest.team

# Random secret for signing sign-in links and sessions.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Resend API key (free tier is fine) from https://resend.com — sends the magic-link emails
RESEND_API_KEY=re_...

# --- Optional ---

# Verified sender for Resend. The default onboarding@resend.dev only delivers
# to the email on your Resend account — verify a domain to email both users.
EMAIL_FROM=Philip Content HQ <hq@uvest.team>

# Public URL of the deployment (used in magic links). If unset, the request
# origin is used, which works on Vercel.
APP_URL=https://your-app.vercel.app
